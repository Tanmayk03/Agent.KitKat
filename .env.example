# Agent KitKat Environment Configuration
APP_NAME="Agent KitKat"
APP_ENV="production"
DEBUG=False
PORT=8000
HOST="127.0.0.1"

# Ollama Local AI Runtime
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:1.5b"
OLLAMA_REQUEST_TIMEOUT_SECONDS=120.0

# Outbound HTTP: set to True if your network needs a system proxy (HTTP_PROXY / HTTPS_PROXY)
HTTP_TRUST_ENV=False

# Extra browser origins allowed to call the API (comma separated). Localhost and private-LAN
# origins (192.168.x.x, 10.x.x.x, 172.16-31.x.x) are always allowed; everything else is blocked.
CORS_EXTRA_ORIGINS=

# Optional: free Adzuna India API keys (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: override the season-named SimplifyJobs internships feed when a new season starts
# SIMPLIFY_INTERNSHIPS_URL=https://raw.githubusercontent.com/SimplifyJobs/Summer2026-Internships/dev/.github/scripts/listings.json

# Uploads
MAX_UPLOAD_MB=10

# Timezone for daily reports and the daily schedule (IANA name)
TIMEZONE=Asia/Kolkata
